# Copy to `.env` and fill in. Never commit `.env`.
# Used only when running with `--remote` (or when ORQ_DB_* are exported).

ORQ_DB_URL=libsql://YOUR_DB.turso.io
ORQ_DB_TOKEN=YOUR_TOKEN_HERE

# Optional embedded replica path (requires libsql sync/core; not enabled yet):
# ORQ_DB_REPLICA=./.ORQ_DATA/replica.db
