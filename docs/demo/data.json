ix(in srgb, var(--muted) 22%, transparent);\r\n  }\r\n  .fill { height: 100%; border-radius: inherit; background: var(--accent); }\r\n  .value { color: var(--muted); text-align: right; }\r\n</style>\r\n</head>\r\n<body>\r\n  <header>\r\n    <h1>Workspace pulse</h1>\r\n    <span class=\"live\">healthy</span>\r\n  </header>\r\n\r\n  <section class=\"metrics\" aria-label=\"Workspace metrics\">\r\n    <div class=\"metric\"><strong>5</strong><span>tasks supervised</span></div>\r\n    <div class=\"metric\"><strong>3</strong><span>guarded triggers</span></div>\r\n    <div class=\"metric\"><strong>0</strong><span>stale leases</span></div>\r\n  </section>\r\n\r\n  <section class=\"pipeline\" aria-label=\"Pipeline progress\">\r\n    <div class=\"row\">\r\n      <span>Plan</span>\r\n      <div class=\"track\"><div class=\"fill\" style=\"width:100%\"></div></div>\r\n      <span class=\"value\">done</span>\r\n    </div>\r\n    <div class=\"row\">\r\n      <span>Execute</span>\r\n      <div class=\"track\"><div class=\"fill\" style=\"width:100%\"></div></div>\r\n      <span class=\"value\">done</span>\r\n    </div>\r\n    <div class=\"row\">\r\n      <span>Review</span>\r\n      <div class=\"track\"><div class=\"fill\" style=\"width:72%\"></div></div>\r\n      <span class=\"value\">gate</span>\r\n    </div>\r\n  </section>\r\n</body>\r\n</html>\r\n",
