        "body": "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n<meta charset=\"utf-8\" />\r\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\r\n<style>\r\n  :root {\r\n    color-scheme: dark light;\r\n    --text: CanvasText;\r\n    --muted: GrayText;\r\n    --accent: LinkText;\r\n    --bg: Canvas;\r\n    --panel: Field;\r\n    --border: GrayText;\r\n  }\r\n  * { box-sizing: border-box; }\r\n  body {\r\n    margin: 0;\r\n    padding: 18px;\r\n    color: var(--text);\r\n    background: var(--panel);\r\n    font: 12px/1.45 Inter, ui-sans-serif, system-ui, sans-serif;\r\n  }\r\n  header {\r\n    display: flex;\r\n    align-items: center;\r\n    justify-content: space-between;\r\n    gap: 12px;\r\n    margin-bottom: 16px;\r\n  }\r\n  h1 { margin: 0; font-size: 16px; letter-spacing: -0.02em; }\r\n  .live {\r\n    display: inline-flex;\r\n    align-items: center;\r\n    gap: 6px;\r\n    color: var(--accent);\r\n    font-size: 10px;\r\n    font-weight: 700;\r\n    letter-spacing: 0.08em;\r\n    text-transform: uppercase;\r\n  }\r\n  .live::before {\r\n    width: 7px;\r\n    height: 7px;\r\n    border-radius: 50%;\r\n    background: currentColor;\r\n    content: \"\";\r\n  }\r\n  .metrics {\r\n    display: grid;\r\n    grid-template-columns: repeat(3, minmax(0, 1fr));\r\n    gap: 8px;\r\n  }\r\n  .metric {\r\n    padding: 12px;\r\n    border: 1px solid var(--border);\r\n    border-radius: 8px;\r\n    background: var(--bg);\r\n  }\r\n  .metric strong { display: block; font-size: 20px; line-height: 1; }\r\n  .metric span { color: var(--muted); font-size: 10px; }\r\n  .pipeline {\r\n    margin-top: 14px;\r\n    padding-top: 12px;\r\n    border-top: 1px solid var(--border);\r\n  }\r\n  .row {\r\n    display: grid;\r\n    grid-template-columns: 68px 1fr 42px;\r\n    align-items: center;\r\n    gap: 8px;\r\n    margin-top: 9px;\r\n  }\r\n  .track {\r\n    height: 6px;\r\n    overflow: hidden;\r\n    border-radius: 999px;\r\n    background: color-mix(in srgb, var(--muted) 22%, transparent);\r\n  }\r\n  .fill { height: 100%; border-radius: inherit; background: var(--accent); }\r\n  .value { color: var(--muted); text-align: right; }\r\n</style>\r\n</head>\r\n<body>\r\n  <header>\r\n    <h1>Workspace pulse</h1>\r\n    <span class=\"live\">healthy</span>\r\n  </header>\r\n\r\n  <section class=\"metrics\" aria-label=\"Workspace metrics\">\r\n    <div class=\"metric\"><strong>5</strong><span>tasks supervised</span></div>\r\n    <div class=\"metric\"><strong>3</strong><span>guarded triggers</span></div>\r\n    <div class=\"metric\"><strong>0</strong><span>stale leases</span></div>\r\n  </section>\r\n\r\n  <section class=\"pipeline\" aria-label=\"Pipeline progress\">\r\n    <div class=\"row\">\r\n      <span>Plan</span>\r\n      <div class=\"track\"><div class=\"fill\" style=\"width:100%\"></div></div>\r\n      <span class=\"value\">done</span>\r\n    </div>\r\n    <div class=\"row\">\r\n      <span>Execute</span>\r\n      <div class=\"track\"><div class=\"fill\" style=\"width:100%\"></div></div>\r\n      <span class=\"value\">done</span>\r\n    </div>\r\n    <div class=\"row\">\r\n      <span>Review</span>\r\n      <div class=\"track\"><div class=\"fill\" style=\"width:72%\"></div></div>\r\n      <span class=\"value\">gate</span>\r\n    </div>\r\n  </section>\r\n</body>\r\n</html>\r\n",
